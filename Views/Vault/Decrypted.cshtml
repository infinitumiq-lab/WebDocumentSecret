    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model VaultEncryptionPOC.Models.FormModel

@{
    ViewData["Title"] = "Decrypted Data";
}

<div class="container mt-5">
    <h1> Decrypted Data</h1>

	<p class="text-success">
		The decryption was successful.
	</p>

	<form>

		<div class="mb-3">
			<label asp-for="FullName" class="form-label">
				Full Name
			</label>

			<input asp-for="FullName" class="form-control"
			readonly/>

		</div>

		<div class="mb-3">
			<label asp-for="DocumentType" class="form-label">
				Document Type
			</label>

			<input asp-for="DocumentType" class="form-control"
				   readonly />
		</div>

		<div class="mb-3">
			<label asp-for="DocumentNumber" class="form-label">
				Document Number
			</label>

			<input asp-for="DocumentNumber" class="form-control"
				   readonly />
		</div>

		<div class="mb-3">
			<label asp-for="Issuer" class="form-label">
				Issuer
			</label>

			<input asp-for="Issuer" class="form-control"
				   readonly />
		</div>

		<div class="mb-3">
			<label asp-for="ExpiryDate" class="form-label">
				Expiry Date
			</label>

			<input asp-for="ExpiryDate" class="form-control"
				   readonly />
		</div>

	</form>

</div>
