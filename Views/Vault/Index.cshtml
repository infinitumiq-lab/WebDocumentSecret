@model IReadOnlyList<VaultEncryptionPOC.Models.Vault.DocumentTypeViewModel>
@{
    ViewData["Title"] = "My Vault";
}
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/vault.css" asp-append-version="true" />
<div class="vault-page">
    <header class="vault-topbar">
        <a asp-controller="Home" asp-action="Index" class="auth-logo">AllThatMatters</a>
        <div class="vault-user-actions">
            <span>@Context.Session.GetString("UserEmail")</span>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button class="secondary-button" type="submit">Sign out</button>
            </form>
        </div>
    </header>
    <section class="vault-content">
        <p class="vault-eyebrow">YOUR PRIVATE SPACE</p>
        <h1>My Vault</h1>
        <p class="vault-intro">Keep the information that matters, organized in one private place.</p>

        @if (TempData["SuccessMessage"] is string successMessage)
        { <div class="success-message" role="status">@successMessage</div> }
        @if (TempData["InfoMessage"] is string infoMessage)
        { <div class="info-message" role="status">@infoMessage</div> }
        @if (ViewBag.ApiMessage is string apiMessage && (!((bool?)ViewBag.ApiSuccess ?? false) || Model.Count == 0))
        { <div class="info-message" role="status">@apiMessage</div> }

        @if (Model.Count > 0)
        {
            <div class="schema-card">
                <label for="documentType">What would you like to add?</label>
                <select id="documentType" class="form-control">
                    <option value="">Choose a document type</option>
                    @foreach (var schema in Model)
                    {
                        <option value="@schema.DocumentTypeId">@schema.TypeName</option>
                    }
                </select>
                <div id="documentFormContainer" class="document-form-container" hidden>
                    <form id="dynamicDocumentForm">
                        @Html.AntiForgeryToken()
                        <div id="documentFields" class="document-fields"></div>
                        <div class="form-group attachment-group">
                            <label for="supportingFiles">Supporting documents (optional)</label>
                            <input id="supportingFiles" name="supportingFiles" class="form-control" type="file" multiple accept=".pdf,.png,.jpg,.jpeg,.doc,.docx" autocomplete="off" />
                            <small>Choose files to include in this local preview. Files are not uploaded or saved yet.</small>
                        </div>
                        <div class="form-actions">
                            <button type="reset" class="secondary-button" id="clearDocumentForm">Clear form</button>
                            <button type="submit" class="auth-button">Review details</button>
                        </div>
                    </form>
                    <section id="formPreviewMessage" class="details-preview" aria-live="polite" hidden>
                        <div class="preview-heading"><h2>Review your details</h2><button type="button" class="secondary-button" id="hidePreview">Hide details</button></div>
                        <p class="preview-warning">This is a private on-screen preview only. Nothing has been saved or encrypted yet.</p>
                        <dl id="previewDetails" class="preview-details"></dl>
                        <div id="previewAttachments" class="preview-attachments"></div>
                    </section>
                </div>
            </div>
        }
        else
        {
            <div class="schema-card empty-state">
                <h2>Document forms are not available yet</h2>
                <p>The form preview now uses the working Documents endpoint. It creates document-type choices from each document type ID and creates fields from the dynamic attribute names returned by the API. If no forms appear, the API may have returned no records or no dynamic attributes.</p>
                <a class="secondary-link" asp-controller="Vault" asp-action="Index">Try again</a>
            </div>
        }
    </section>
</div>
@if (Model.Count > 0)
{
    <script>
        window.allThatMattersFormSchemas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));
    </script>
    <script src="~/js/vault.js" asp-append-version="true"></script>
}
