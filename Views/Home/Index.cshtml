@{
    ViewData["Title"] = "Everything that matters";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}

<div class="landing-page">
    <header class="landing-nav">
        <div class="landing-container nav-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="allthatmatters home">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 32 32" role="img">
                        <path d="M10 10.5V8.8C10 5.6 12.7 3 16 3s6 2.6 6 5.8v1.7" />
                        <rect x="7" y="9" width="18" height="20" rx="5" />
                        <circle cx="16" cy="18" r="1.5" />
                        <path d="M16 19.5v4" />
                    </svg>
                </span>
                <span class="brand-text"><span>allthat</span><em>matters</em></span>
            </a>

            <nav class="desktop-nav" aria-label="Primary navigation">
                <a href="#why-it-matters">Why it matters</a>
                <a href="#our-promise">Our promise</a>
                @if (Context.Session.GetString("AccessToken") is not null)
                {
                    <a class="nav-sign-in" asp-controller="Vault" asp-action="Index">My vault</a>
                    <form class="nav-logout-form" asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="nav-sign-in nav-logout-button" type="submit">Sign out</button></form>
                }
                else
                {
                    <a class="nav-sign-in" asp-controller="Account" asp-action="Login">Sign in</a>
                    <a class="nav-sign-in" asp-controller="Account" asp-action="Register">Create account</a>
                }
            </nav>

            <button class="mobile-menu-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavigation" aria-controls="mobileNavigation" aria-label="Open navigation">
                <span></span>
                <span></span>
            </button>
        </div>
    </header>

    <div class="offcanvas offcanvas-end mobile-navigation" tabindex="-1" id="mobileNavigation" aria-labelledby="mobileNavigationLabel">
        <div class="offcanvas-header">
            <span class="mobile-brand" id="mobileNavigationLabel">allthat<span>matters</span></span>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <a href="#why-it-matters" data-bs-dismiss="offcanvas">Why it matters</a>
            <a href="#our-promise" data-bs-dismiss="offcanvas">Our promise</a>
            @if (Context.Session.GetString("AccessToken") is not null)
            {
                <a asp-controller="Vault" asp-action="Index">My vault</a>
                <form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="mobile-cta" type="submit">Sign out</button></form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Sign in</a>
                <a class="mobile-cta" asp-controller="Account" asp-action="Register">Open your private vault <span>→</span></a>
            }
        </div>
    </div>

    <section class="hero-section" aria-labelledby="hero-heading">
        <div class="landing-container hero-grid">
            <div class="hero-copy">
                <p class="eyebrow"><span aria-hidden="true">✣</span> A quieter kind of preparedness</p>

                <h1 id="hero-heading">
                    Everything that<br />
                    matters,<br />
                    <em>held with care.</em>
                </h1>

                <p class="hero-description">
                    Keep the records, wishes, and practical details your family may one day need —
                    organized privately, and ready for the right people at the right time.
                </p>

                <div class="hero-actions">
                    <a class="primary-cta" href="/Account/Register">
                        <span>Open your private vault</span>
                        <span aria-hidden="true">→</span>
                    </a>

                    <span class="privacy-note">
                        <span class="privacy-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <rect x="5" y="10" width="14" height="11" rx="2" />
                                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                            </svg>
                        </span>
                        Your information stays yours
                    </span>
                </div>
            </div>

            <div class="hero-art" aria-hidden="true">
                <div class="art-orbit art-orbit-one"></div>
                <div class="art-orbit art-orbit-two"></div>
                <div class="art-paper art-paper-back"></div>
                <div class="art-paper art-paper-middle"></div>

                <div class="art-document">
                    <div class="document-heart">
                        <svg viewBox="0 0 24 24">
                            <path d="M20.8 8.6c0 5.4-8.8 10.5-8.8 10.5S3.2 14 3.2 8.6A4.6 4.6 0 0 1 12 6.2a4.6 4.6 0 0 1 8.8 2.4Z" />
                        </svg>
                    </div>

                    <p class="document-kicker">THE RHODES FAMILY</p>
                    <h2>A life, carefully<br />gathered.</h2>

                    <div class="document-divider"></div>

                    <ul>
                        <li><span>✓</span> Wishes &amp; instructions</li>
                        <li><span>✓</span> Financial records</li>
                        <li><span>✓</span> People to contact</li>
                    </ul>
                </div>

                <div class="protected-badge">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 3l7 3v5c0 4.5-2.9 8.1-7 10-4.1-1.9-7-5.5-7-10V6l7-3Z" />
                        <path d="m9 12 2 2 4-4" />
                    </svg>
                    <span>Protected</span>
                </div>
            </div>
        </div>
    </section>

    <section class="support-section" id="why-it-matters">
        <div class="landing-container support-grid">
            <div>
                <p class="eyebrow">Why it matters</p>
                <h2>Some things are too important to leave scattered.</h2>
            </div>
            <p>
                Important records are often spread across drawers, email accounts, phones and paperwork.
                AllThatMatters gives them one considered place — so you can keep what matters organized before it matters most.
            </p>
        </div>
    </section>

    <section class="promise-section" id="our-promise">
        <div class="landing-container promise-card">
            <div>
                <p class="eyebrow">Our promise</p>
                <h2>Private by design.<br /><em>Ready when needed.</em></h2>
            </div>
            <p>
                We are building AllThatMatters around privacy, thoughtful organization and clear access —
                without making preparedness feel complicated.
            </p>
        </div>
    </section>

    <footer class="landing-footer">
        <div class="landing-container footer-inner">
            <a class="brand footer-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 32 32">
                        <path d="M10 10.5V8.8C10 5.6 12.7 3 16 3s6 2.6 6 5.8v1.7" />
                        <rect x="7" y="9" width="18" height="20" rx="5" />
                        <circle cx="16" cy="18" r="1.5" />
                        <path d="M16 19.5v4" />
                    </svg>
                </span>
                <span class="brand-text"><span>allthat</span><em>matters</em></span>
            </a>

            <p>© @DateTime.UtcNow.Year allthatmatters. Built for the things that matter.</p>
        </div>
    </footer>
</div>
