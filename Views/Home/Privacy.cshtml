@{
    ViewData["Title"] = "Privacy Policy";
    var signedIn = !string.IsNullOrWhiteSpace(Context.Session.GetString("AccessToken"));
}
@section Styles { <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" /> }
<div class="privacy-page">
    <header class="privacy-header"><a class="app-brand" asp-controller="Home" asp-action="@(signedIn ? "Dashboard" : "Index")"><span class="app-brand-mark">✦</span><span>allthat<strong>matters</strong></span></a><a class="app-nav-link" asp-controller="Home" asp-action="@(signedIn ? "Dashboard" : "Index")">← Back to @(signedIn ? "dashboard" : "home")</a></header>
    <main class="privacy-card"><p class="page-kicker">YOUR TRUST MATTERS</p><h1>Privacy at AllThatMatters</h1><p class="privacy-lead">Your important information deserves thoughtful protection. This page will explain what information the service collects, how it is used, how it is protected, and what choices you have.</p><div class="privacy-notice"><strong>Policy status</strong><p>This is a placeholder for the project's formal privacy policy, not a complete or legally reviewed policy. Please do not treat it as the final statement of our practices.</p></div><h2>What this page will cover</h2><ul><li>Account information and authentication</li><li>How saved vault information is encrypted, stored, and accessed</li><li>Reminders, activity records, and service providers</li><li>Data retention, account deletion, and your choices</li><li>How to contact the team with privacy questions</li></ul><div class="privacy-actions"><a class="dashboard-primary-cta" asp-controller="Home" asp-action="@(signedIn ? "Dashboard" : "Index")">Return to @(signedIn ? "dashboard" : "home") <span>→</span></a>@if(signedIn){<a class="text-link" asp-controller="Vault" asp-action="Index">Open vault</a>}</div></main>
</div>
<style>.privacy-page{min-height:100vh;background:#f3f2ee;padding:28px clamp(18px,5vw,72px) 70px;color:#171714}.privacy-header{max-width:1050px;margin:0 auto 55px;display:flex;align-items:center;justify-content:space-between;gap:18px}.privacy-card{max-width:820px;margin:0 auto;background:#fff;border:1px solid #e9e6dc;border-radius:22px;padding:clamp(26px,5vw,54px);box-shadow:0 18px 55px rgba(0,0,0,.04)}.privacy-card h1{font-size:clamp(2rem,5vw,3.3rem);letter-spacing:-.05em;line-height:1.08;margin:0 0 18px}.privacy-lead{font-size:1.08rem;line-height:1.8;color:#68675f}.privacy-card h2{font-size:1.2rem;margin:30px 0 12px}.privacy-card ul{padding-left:22px;color:#626159;line-height:1.9}.privacy-notice{margin:26px 0;padding:18px 20px;border-radius:13px;background:#fff4ce;color:#5f4b0b}.privacy-notice p{margin:6px 0 0;line-height:1.65}.privacy-actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap;margin-top:30px}@@media (max-width: 550px){.privacy-header{align-items:flex-start;flex-direction:column;margin-bottom:28px}.privacy-card{border-radius:16px}}</style>
