@model VaultEncryptionPOC.Models.Account.VerifyEmailViewModel
@{
    ViewData["Title"] = "Verify your email";
}
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <a asp-controller="Home" asp-action="Index" class="auth-logo">AllThatMatters</a>
            <h1>Verify your email</h1>
            <p>Open the verification link sent to your inbox. If the link did not fill in the token, paste the token from the email below.</p>
        </div>

        <form asp-controller="User" asp-action="Verify" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="form-group">
                <label asp-for="Token"></label>
                <input asp-for="Token" class="form-control" autocomplete="one-time-code" spellcheck="false" />
                <span asp-validation-for="Token" class="field-validation"></span>
            </div>
            <button type="submit" class="auth-button">Verify email</button>
        </form>

        <div class="auth-footer">
            Already verified? <a asp-controller="Account" asp-action="Login">Sign in</a>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
