@model VaultEncryptionPOC.Models.Account.ResetPasswordViewModel
@{ ViewData["Title"] = "Reset password"; }
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
<div class="auth-page"><div class="auth-card">
    <div class="auth-header"><a asp-controller="Home" asp-action="Index" class="auth-logo">AllThatMatters</a><h1>Choose a new password</h1><p>Enter the reset code from your email and choose a new password.</p></div>
    @if (TempData["SuccessMessage"] is string successMessage) { <div class="success-message" role="status">@successMessage</div> }
    <form asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="form-group"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="field-validation"></span></div>
        <div class="form-group"><label asp-for="Token">Reset code</label><input asp-for="Token" class="form-control" autocomplete="one-time-code" /><span asp-validation-for="Token" class="field-validation"></span></div>
        <div class="form-group"><label asp-for="NewPassword"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="field-validation"></span></div>
        <div class="form-group"><label asp-for="ConfirmNewPassword"></label><input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmNewPassword" class="field-validation"></span></div>
        <button type="submit" class="auth-button">Reset password</button>
    </form>
    <div class="auth-footer"><a asp-action="ForgotPassword">Request another reset code</a> · <a asp-action="Login">Back to sign in</a></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
