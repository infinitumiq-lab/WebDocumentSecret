@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model VaultEncryptionPOC.Models.Account.LoginViewModel

@{
    ViewData["Title"] = "Sign in";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-header">
            <a asp-controller="Home"
               asp-action="Index"
               class="auth-logo">
                AllThatMatters
            </a>

            <h1>Welcome back</h1>

            <p>
                Sign in to access your private vault.
            </p>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="success-message" role="status">@successMessage</div>
        }
        @if (TempData["InfoMessage"] is string infoMessage)
        {
            <div class="info-message" role="status">@infoMessage</div>
        }

        <form class="js-loading-form" data-loading-label="Signing you in…" asp-action="Login"
              method="post"
              autocomplete="off"
              novalidate>

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary"
                 role="alert">
            </div>

            <div class="form-group">
                <label asp-for="Username"></label>

                <input asp-for="Username"
                       class="form-control"
                       autocomplete="off" />

                <span asp-validation-for="Username"
                      class="field-validation">
                </span>
            </div>

            <div class="form-group">
                <div class="password-label-row">
                    <label asp-for="Password"></label>
                    <a asp-action="ForgotPassword">Forgot password?</a>
                </div>

                <input asp-for="Password"
                       class="form-control"
                       autocomplete="new-password" />

                <span asp-validation-for="Password"
                      class="field-validation">
                </span>
            </div>

            <button type="submit" class="auth-button js-loading-submit">
                <span class="button-label">Sign in</span><span class="button-spinner" aria-hidden="true"></span>
            </button>

        </form>
        <p class="login-privacy-note">For your security, this page does not offer a “remember me” option. If your browser or password manager fills saved credentials, remove the saved entry there and sign out after using a shared device.</p>

        <div class="auth-footer">
            Don't have an account?
            <a asp-action="Register">Create one</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-loading.js" asp-append-version="true"></script>
    <script src="~/js/login-security.js" asp-append-version="true"></script>
}