@model VaultEncryptionPOC.Models.Account.ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot password"; }
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
<div class="auth-page"><div class="auth-card">
    <div class="auth-header"><a asp-controller="Home" asp-action="Index" class="auth-logo">AllThatMatters</a><h1>Forgot your password?</h1><p>Enter the email address linked to your account. If it is registered, we’ll send reset instructions.</p></div>
    <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="form-group"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="field-validation"></span></div>
        <button type="submit" class="auth-button">Send reset instructions</button>
    </form>
    <div class="auth-footer"><a asp-action="Login">Back to sign in</a></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
